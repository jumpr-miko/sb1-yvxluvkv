          "body": "<p data-local-id=\"badf91f9fa00\"><strong>Changes made:</strong><br></p><table data-local-id=\"4b1c17a9-7a58-47c6-89a8-432c53936c3f\"><tbody><tr><td data-local-id=\"c5fe18e5ae23\" data-background=\"#f2f3f4\" style=\"background-color: #f2f3f4\"><p data-local-id=\"70fcf4b85a02\">Metadata Name</p></td><td data-local-id=\"40e393e8a95a\" data-background=\"#f2f3f4\" style=\"background-color: #f2f3f4\"><p data-local-id=\"15d58ae8ff33\">Metadata Type</p></td><td data-local-id=\"4238a44ffd65\" data-background=\"#f2f3f4\" style=\"background-color: #f2f3f4\"><p data-local-id=\"0968ddb7206d\">Action</p></td><td data-local-id=\"812095d0a4f9\" data-background=\"#f2f3f4\" style=\"background-color: #f2f3f4\"><p data-local-id=\"52ddf1194c48\">Notes</p></td></tr><tr><td data-local-id=\"8fd9e03724f8\"><p data-local-id=\"a6ac57f6924f\">Deal.Deal_Makeup_Key__c</p></td><td data-local-id=\"26ec5cbd27c9\"><p data-local-id=\"88c08ec23747\">CustomField</p></td><td data-local-id=\"bf3a3c3cf0ae\"><p data-local-id=\"d6698ff0d602\">New Component</p></td><td data-local-id=\"a6d4a8e3198d\"><p data-local-id=\"2a9a3cb90fbf\"></p></td></tr><tr><td data-local-id=\"e371129def07\"><p data-local-id=\"925d85ac2932\">Deal.Makeup_Drift__c</p></td><td data-local-id=\"50b31934b4ee\"><p data-local-id=\"74345c9e3f17\">CustomField</p></td><td data-local-id=\"7fa0d33885aa\"><p data-local-id=\"e331d115a408\">New Component</p></td><td data-local-id=\"18370215f33b\"><p data-local-id=\"722baa8ca2dc\"></p></td></tr><tr><td data-local-id=\"c9e133380e3d\"><p data-local-id=\"5ef77f22589e\">WT_Deal_Edit</p></td><td data-local-id=\"e43098016628\"><p data-local-id=\"09d047135f36\">PermissionSet</p></td><td data-local-id=\"0d2880826882\"><p data-local-id=\"ee264631bd60\">Update Component</p></td><td data-local-id=\"81709873a7a8\"><p data-local-id=\"fb5cf61f6644\">Added Deal.Deal_Makeup_Key__c &amp; Deal.Makeup_Drift__c</p></td></tr><tr><td data-local-id=\"b3df405bc1fe\"><p data-local-id=\"3bf829cbd44a\">WT