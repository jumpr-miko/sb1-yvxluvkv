          "jsdPublic": true
        },
        {
          "id": "10563",
          "author": {
            "accountId": "712020:e303283b-a074-400e-9470-8d704ea7427d",
            "emailAddress": "taryn@jumpr.io",
            "displayName": "Taryn Reithofer",
            "active": true,
            "timeZone": "America/Toronto",
            "accountType": "atlassian"
          },
          "body": "<p data-local-id=\"7bb95cad9b23\">Clarifying with Emily “Would this one be two separate conditions, each with its own banner, OR One combined condition. A banner that only shows when both are true at once?”</p>",
          "updateAuthor": {
            "accountId": "712020:e303283b-a074-400e-9470-8d704ea7427d",
            "emailAddress": "taryn@jumpr.io",
            "displayName": "Taryn Reithofer",
            "active": true,
            "timeZone": "America/Toronto",
            "accountType": "atlassian"
          },
          "created": "2026-09-15T16:18:33.317-0400",
          "updated": "2026-09-15T16:18:33.317-0400",
          "jsdPublic": true
        },
        {
          "id": "11259",
          "author": {
            "accountId": "712020:e303283b-a074-400e-9470-8d704ea7427d",
            "emailAddress": "taryn@jumpr.io",
            "displayName": "Taryn Reithofer",
