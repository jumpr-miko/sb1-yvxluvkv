    "description": "**Previous Formula:**\n\nIF(Fraud_Flag__c, \"🚩 \", \"\") &\n\nIF(AND(Log_Overdue\\__c, ISPICKVAL(Status_\\_c, 'In Progress')), \"⚠️ \", \"\") &\n\nCASE(TEXT(Status__c),\n\n'New', \"🆕 New\",\n\n'Completed', \"✅ Completed\",\n\n'Archived', \"📦 Archived\",\n\nCASE(\n\n(IF(NOT(ISBLANK(Deposit_Proof__c)), 1, 0) +\n\nIF(NOT(ISBLANK(Sign_up_Proof__c)), 1, 0) +\n\nIF(NOT(ISBLANK(Wager_Proof__c)), 1, 0)),\n\n3, \"🟢 3/3\",\n\n2, \"🟡 2/3\",\n\n1, \"🔴 1/3\",\n\n\"🔴 0/3\"\n\n) & \" \" &\n\nCASE(Status__c,\n\n'In Progress', \"🔄 In Progress\",\n\nTEXT(Status__c)\n\n)\n\n)\n\n**New Formula:**\n\nCASE(TEXT(Status\\__c), 'New', \"🆕 New\", 'Completed', \"✅ Completed\", 'Archived', \"📦 Archived\", CASE( (IF(NOT(ISBLANK(Deposit_Proofc)), 1, 0) + IF(NOT(ISBLANK(Sign_up_Proofc)), 1, 0) + IF(NOT(ISBLANK(Wager_Proofc)), 1, 0)), 3, \"🟢 3/3\", 2, \"🟡 2/3\", 1, \"🔴 1/3\", \"🔴 0/3\" ) & \" \" & CASE(Statusc, 'In Progress', \"🔄 In Progress\", TEXT(Status_\\_c)) )",
